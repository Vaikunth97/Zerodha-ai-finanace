@app.post("/api/portfolio-analysis", response_model=PortfolioAnalysisResponse)
def api_portfolio_analysis(req: PortfolioAnalysisRequest):
    # 1. Load portfolio holdings (as DataFrame or list)
    pf_df = portfolio.get_portfolio_df(req.portfolio_id)
    if pf_df is None:
        raise HTTPException(status_code=404, detail="Portfolio not found")

    # 2. Update with current prices
    pf_with_prices = market.updated_current_price(pf_df)

    # 3. Fetch news/signals
    news_signals = news.get_news_signals(req.portfolio_id, timeframe=req.timeframe)

    # 4. Run analytics engine
    analytics_result = analytics.run_portfolio_analytics(
        portfolio_df=pf_with_prices,
        news_signals=news_signals,
        timeframe=req.timeframe,
    )

    # 5. (Later) generate AI insights
    # insights = chatbot.generate_insights(analytics_result, req.insight_type)

    job_id = f"JOB-{req.portfolio_id}-{req.timeframe}"

    return PortfolioAnalysisResponse(
        job_id=job_id,
        status="completed",
        message="Portfolio analytics completed.",
    )
