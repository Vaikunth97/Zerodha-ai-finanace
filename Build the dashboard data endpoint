@app.get("/api/dashboard/{portfolio_id}", response_model=DashboardResponse)
def api_dashboard(portfolio_id: str, timeframe: str = "1W"):
    pf_df = portfolio.get_portfolio_df(portfolio_id)
    if pf_df is None:
        raise HTTPException(status_code=404, detail="Portfolio not found")

    pf_with_prices = market.updated_current_price(pf_df)
    news_signals = news.get_news_signals(portfolio_id, timeframe=timeframe)

    analytics_result = analytics.run_portfolio_analytics(
        portfolio_df=pf_with_prices,
        news_signals=news_signals,
        timeframe=timeframe,
    )

    return DashboardResponse(**analytics_result)
