# ===== Internal helpers =====

def _load_portfolio_df_from_upload(file: UploadFile) -> pd.DataFrame:
    """
    Use existing read_portfolio, valid_coloumn, and clean_data without modifying them.
    """
    try:
        contents = file.file.read()
        suffix = os.path.splitext(file.filename)[1]

        # Write uploaded contents to a temporary file so read_portfolio can use .name
        with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as tmp:
            tmp.write(contents)
            tmp_path = tmp.name

        class TempFile:
            def __init__(self, name):
                self.name = name

        uploaded_file = TempFile(tmp_path)
        df = read_portfolio(uploaded_file)

        missing = valid_coloumn(df)
        if missing:
            raise HTTPException(
                status_code=400,
                detail=f"Missing required columns: {', '.join(missing)}",
            )

        df_clean = clean_data(df)
        return df_clean

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Error reading portfolio file: {e}")


def _build_dashboard_payload(df_with_prices: pd.DataFrame, benchmark_change_pct: float) -> dict:
    """
    Build the full dashboard analytics payload using analytics layer.
    """
    summary = calculate_portfolio_summary(df_with_prices)
    sector_breakdown = compute_sector_breakdown(df_with_prices)
    risk_alerts_list = get_risk_alerts(df_with_prices)
    benchmark_metrics_dict = compare_to_benchmark(
        df=df_with_prices,
        benchmark_change_pct=benchmark_change_pct,
    )

    return {
        "portfolio_summary": summary,
        "sector_breakdown": sector_breakdown,
        "risk_alerts": risk_alerts_list,
        "benchmark_metrics": BenchmarkMetrics(**benchmark_metrics_dict),
    }


# ===== Analytics endpoints =====

@app.post("/api/portfolio/upload-and-analyze", response_model=PortfolioAnalysisResponse)
async def upload_and_analyze_portfolio(
    file: UploadFile = File(...),
    timeframe: str = "1D",
    insight_type: str = "portfolio_summary",
    benchmark_change_pct: float = 0.5,
):
    """
    Upload portfolio (CSV/XLSX), clean it, enrich with prices, run analytics.
    Uses ONLY existing service + analytics functions.
    """
    df_clean = _load_portfolio_df_from_upload(file)
    df_with_prices = updated_current_price(df_clean)

    # Run analytics so we know the portfolio is analyzable
    _ = calculate_portfolio_summary(df_with_prices)
    _ = compute_sector_breakdown(df_with_prices)
    _ = get_risk_alerts(df_with_prices)
    _ = compare_to_benchmark(df_with_prices, benchmark_change_pct)

    job_id = f"JOB-upload-{file.filename}-{timeframe}"

    return PortfolioAnalysisResponse(
        job_id=job_id,
        status="completed",
        message="Portfolio uploaded and analytics completed.",
    )


@app.post("/api/dashboard/from-file", response_model=DashboardResponse)
async def dashboard_from_file(
    file: UploadFile = File(...),
    timeframe: str = "1D",
    benchmark_change_pct: float = 0.5,
):
    """
    Upload a portfolio file and get full dashboard analytics JSON in one call.
    """
    df_clean = _load_portfolio_df_from_upload(file)
    df_with_prices = updated_current_price(df_clean)

    payload = _build_dashboard_payload(df_with_prices, benchmark_change_pct)
    return DashboardResponse(**payload)


@app.get("/api/news/{symbol}")
def api_get_news(symbol: str):
    """
    Fetch stock news using service.news.get_stock_news().
    """
    try:
        articles = get_stock_news(symbol)
        return {"symbol": symbol, "articles": articles}
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"News fetch error: {e}")


@app.get("/api/stock/{symbol}")
def api_get_stock_info(symbol: str):
    """
    Fetch basic stock info (name, sector, etc.) using service.market.get_stock_info().
    """
    try:
        info = get_stock_info(symbol)
        if not info:
            raise HTTPException(status_code=404, detail="Stock info not found")
        return {"symbol": symbol, "info": info}
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Stock info error: {e}")


